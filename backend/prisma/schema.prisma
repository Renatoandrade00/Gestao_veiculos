// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Vehicle {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand        String
  model        String
  year         Int
  engine       String
  plate        String?
  mileage      Int
  maintenances MaintenanceRecord[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model MaintenanceRecord {
  id                     String    @id @default(uuid())
  vehicleId              String
  vehicle                Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type                   String // e.g. "Óleo", "Pastilhas", "Pneus", "Filtros", "Geral"
  description            String
  mileageAtMaintenance   Int
  dateOfMaintenance      DateTime
  nextMaintenanceMileage Int?
  nextMaintenanceDate    DateTime?
  notes                  String?
  status                 String    @default("COMPLETED") // COMPLETED, PENDING
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model CarSpecsReference {
  id     String @id @default(uuid())
  brand  String
  model  String
  engine String

  // Óleo e Manutenção
  recommendedOil String
  oilCapacity    Float
  sparkPlugModel String?
  brakeFluidType String?
  coolantType    String?

  // Pneus e Pressão
  tirePressureFront Int
  tirePressureRear  Int
  tireSize          String?

  // Motorização
  powerAndTorque     String?
  fuelType           String?
  averageConsumption String?

  // Estrutura e Elétrica
  fuelTankCapacity  String?
  suspensionType    String?
  headlightBulb     String?
  trunkCapacity     String?
  otherRelevantData String?

  createdAt DateTime @default(now())

  @@unique([brand, model, engine])
}
