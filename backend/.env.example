# Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ───────────────────────────────────
# PostgreSQL (dev ou prod): postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL="postgresql://user:password@host:port/database"

# ─── JWT (OBRIGATÓRIO) ──────────────────────────
# O servidor se recusa a iniciar sem esta variável.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_A_LONG_RANDOM_SECRET"

# ─── Server ─────────────────────────────────────
PORT=3000

# ─── CORS ────────────────────────────────────────
# Origens permitidas, separadas por vírgula. Obrigatório em produção.
# Ex: CORS_ORIGINS=https://vehicle-maintenance-frontend-mb92.onrender.com,http://localhost:5173
CORS_ORIGINS="http://localhost:5173"

# ─── Email (SMTP) — Optional ────────────────────
# Leave empty to use Ethereal mock in development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password

# ─── Ethereal (dev) — Optional ───────────────────
# Cria uma conta em https://ethereal.email e preencha para visualizar
# os e-mails de alerta em um navegador durante o desenvolvimento.
# ETHEREAL_USER=
# ETHEREAL_PASS=
